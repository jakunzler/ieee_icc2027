# Endereços lab CERISE — Tower02 = rede 5G (gNB+Open5GS) + jammer
# Source:  source configs/lab_addrs.env

# Host
HOST_ROLE=network_jammer
HOSTNAME_HINT=cerise-Precision-5860-Tower02

# Interface 10GbE host ↔ gNB X310
# Path: Tower02 enp2s0 → DGS-1510-28X port 25 (SFP+ 10G) → port 27 (MM fiber) → X310 SFP+#1
GNB_IFACE=enp2s0
GNB_HOST_IP=192.168.40.5
GNB_USRP_ADDR=192.168.40.3
GNB_USRP_SERIAL=33A356E
GNB_SWITCH=DGS-1510-28X
GNB_SWITCH_PORT_HOST=25
GNB_SWITCH_PORT_USRP=27
GNB_USRP_SFP=1
# Web UI DGS-1510 (default): 10.90.90.90/8 — no host: sudo ip addr add 10.90.90.91/8 dev enp2s0
# Doc: documents/reference_article_reproduction/registro_jumbo_uhd_x310_rede_5g.md §5

# Jammer X410 (via rede lab 1GbE 172.16.2.0/23)
# Host tipicamente enp0s31f6 → 172.16.2.241 (não é o 10GbE do gNB)
JAMMER_IFACE=enp0s31f6
JAMMER_USRP_ADDR=172.16.3.117
JAMMER_USRP_SERIAL=33BF029
JAMMER_USRP_TYPE=x4xx
# fs 30.72e6 ≈ 983 Mb/s → satura; 15.36e6 ≈ 491 Mb/s → U na lab; 7.68e6 ≈ 246 Mb/s (default)
JAMMER_FS_HZ=7680000
JAMMER_OTW=sc16
JAMMER_NUM_SEND_FRAMES=512
JAMMER_SEND_BUFF_SIZE=8000000

# Watchdog (outra WS — Tower03); não usar captura nesta máquina
WATCHDOG_USRP_ADDR=192.168.40.2
WATCHDOG_USRP_SERIAL=338F075

# Open5GS / srsRAN
AMF_NGAP_ADDR=127.0.1.100
AMF_NGAP_PORT=38412
UE_SUBNET=10.45.0.0/16
# DEFAULT gNB do lab: 100 MHz · 1T1R · 3750 MHz (n78, ARFCN 650000)
GNB_CONFIG=configs/gnb_n78_100mhz_1t1r_x310.yml
# YAMLs ligam metrics.autostart_stdout_metrics (tabela UE no stdout p/ trace)
# Sem jumbo (frame 1488): gnb_run.sh faz auto-fallback para gnb_n78_40mhz_2t2r_x310.yml
# Forçar 100 MHz: sudo bash scripts/gnb_run.sh --force
# Alternativas: configs/gnb_n78_100mhz_2t2r_x310.yml | configs/gnb_n78_40mhz_2t2r_x310.yml
GNB_BIN=gnb

# RF defaults (artigo / n78) — alinhados ao GNB_CONFIG acima
FC_HZ=3750000000
F_SSB_HZ=3709920000
JAMMER_BW_HZ=7200000
# Ganho TX UHD (dB). 0 = seguro/quase invisível a 1 m com atenuadores.
# Calibrar G0 no watchdog (lab_collection_plan §3.3): tipicamente 15–35 dB no CERISE.
# Ex.: export JAMMER_GAIN_DB=20   ou   jammer_run.sh --gain 20
JAMMER_GAIN_DB=20
JAMMER_AMPLITUDE=0.55
